<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Unauthenticated.master.cs" Inherits="VelascoPersonalWebsite_IPT.Unauthenticated" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - Velasco Personal Website</title>
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light text-dark">
    <form id="form1" runat="server">

        <header>
            <nav class="navbar bg-white border-bottom py-3" aria-label="Main navigation">
                <div class="container-fluid px-3 px-md-4">

                    <asp:HyperLink ID="BrandLink" runat="server" 
                        CssClass="navbar-brand fw-semibold text-dark mb-0">
                        <img src="<%= ResolveUrl("~/assets/svg/tilla_logo.svg") %>"
                            alt="owl."
                            class="img-fluid d-block"
                            width="40"
                            height="40" />
                    </asp:HyperLink>

                    <asp:HyperLink ID="SignInLink" runat="server" NavigateUrl="~/login"
                        CssClass="btn btn-dark btn-sm px-3 py-2" Text="Sign in" />
                </div>
            </nav>
        </header>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

    </form>
</body>
</html>